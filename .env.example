# demo: generated SPY/QQQ snapshots; mcp: Robinhood Trading MCP
DATA_MODE=demo

MCP_SERVER_URL=https://agent.robinhood.com/mcp/trading
MCP_REDIRECT_URI=http://127.0.0.1:8000/api/mcp/callback
MCP_TOKEN_STORE=.data/robinhood-oauth.json

# Optional override for an MCP server that uses a pre-issued bearer token.
MCP_BEARER_TOKEN=

# Calculation assumptions
RISK_FREE_RATE=0.045
DEFAULT_AUTO_REFRESH_SECONDS=60

